<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Instant Mechanic</string>

    <!-- Home -->
    <string name="home_title">Find a mechanic</string>
    <plurals name="home_subtitle">
        <item quantity="one">%1$d garage near you</item>
        <item quantity="other">%1$d garages near you</item>
    </plurals>
    <string name="home_search_hint">Search garage, area or service</string>
    <string name="home_search_clear">Clear search</string>
    <string name="home_filter_open_now">Open now</string>
    <string name="home_filter_all_services">All services</string>
    <string name="home_sort_by">Sort by %1$s</string>
    <string name="home_empty_title">No garages found</string>
    <string name="home_empty_body">Try a different search, or clear your filters.</string>
    <string name="home_clear_filters">Clear filters</string>
    <string name="home_debug_menu">Developer options</string>
    <string name="home_debug_simulate_error">Simulate network error</string>

    <!-- Mechanic card / shared -->
    <string name="status_open">Open now</string>
    <string name="status_closed">Closed</string>
    <string name="verified">Verified</string>
    <string name="reviews_count">(%1$s)</string>
    <plurals name="rating_content_description">
        <item quantity="one">Rated %1$s out of 5 from %2$d review</item>
        <item quantity="other">Rated %1$s out of 5 from %2$d reviews</item>
    </plurals>
    <!-- "+1 more" is correct at every count, so no plural is needed here. -->
    <string name="more_services" tools:ignore="PluralsCandidate">+%1$d more</string>

    <!-- Detail -->
    <string name="detail_title">Garage details</string>
    <string name="detail_back">Back</string>
    <string name="detail_about">About</string>
    <string name="detail_services_offered">Services offered</string>
    <string name="detail_working_hours">Working hours</string>
    <string name="detail_contact">Contact</string>
    <string name="detail_call">Call</string>
    <string name="detail_call_content_description">Call %1$s</string>
    <string name="detail_no_dialer">No dialer app found on this device</string>
    <string name="detail_request_service">Request service</string>
    <string name="detail_price_range">Typical cost</string>
    <string name="detail_today">Today</string>

    <!-- Request form -->
    <string name="request_title">Request service</string>
    <string name="request_at_garage">at %1$s</string>
    <string name="request_field_name">Your name</string>
    <string name="request_field_phone">Phone number</string>
    <string name="request_field_phone_prefix">+91</string>
    <string name="request_field_vehicle">Vehicle number</string>
    <string name="request_field_vehicle_hint">MH12AB1234</string>
    <string name="request_field_service">Service needed</string>
    <string name="request_field_description">Describe the problem</string>
    <string name="request_field_description_counter">%1$d/%2$d</string>
    <string name="request_submit">Submit request</string>
    <string name="request_submitting">Submitting…</string>
    <string name="request_service_picker">Choose a service</string>

    <!-- Validation messages: worded here, decided in the domain layer.
         The counts are compile-time constants in ServiceRequestValidator (2, 10, 500), so none of
         them can ever be 1 and a plural would only add an unreachable branch. -->
    <string name="validation_name_required">Please enter your name</string>
    <string name="validation_name_too_short" tools:ignore="PluralsCandidate">Name must be at least %1$d characters</string>
    <string name="validation_name_invalid">Name can only contain letters, spaces and . \' -</string>
    <string name="validation_phone_required">Please enter your phone number</string>
    <string name="validation_phone_invalid">Enter a valid 10-digit mobile number</string>
    <string name="validation_vehicle_required">Please enter your vehicle number</string>
    <string name="validation_vehicle_invalid">Enter a valid number plate, e.g. MH12AB1234</string>
    <string name="validation_service_required">Please choose a service</string>
    <string name="validation_description_required">Please describe the problem</string>
    <string name="validation_description_too_short" tools:ignore="PluralsCandidate">Add a little more detail (at least %1$d characters)</string>
    <string name="validation_description_too_long" tools:ignore="PluralsCandidate">Please keep this under %1$d characters</string>

    <!-- Confirmation -->
    <string name="confirmation_headline">You\'re booked in</string>
    <string name="confirmation_body">%1$s has received your request and will call you shortly.</string>
    <string name="confirmation_request_id">Request ID</string>
    <string name="confirmation_eta">Mechanic arrives in</string>
    <string name="confirmation_done">Done</string>

    <!-- Errors -->
    <string name="error_title_network">No internet connection</string>
    <string name="error_body_network">Check your connection and try again.</string>
    <string name="error_title_timeout">This is taking too long</string>
    <string name="error_body_timeout">The server didn\'t respond in time. Please try again.</string>
    <string name="error_title_server">Something went wrong</string>
    <string name="error_body_server">Our service is temporarily unavailable. Please try again in a moment.</string>
    <string name="error_title_not_found">Not found</string>
    <string name="error_body_not_found">This garage is no longer listed.</string>
    <string name="error_title_parse">Unexpected response</string>
    <string name="error_body_parse">We couldn\'t read the server\'s response. Please update the app.</string>
    <string name="error_title_unknown">Something went wrong</string>
    <string name="error_body_unknown">An unexpected error occurred. Please try again.</string>
    <string name="error_retry">Try again</string>

    <!-- Generic -->
    <string name="loading">Loading</string>
</resources>
